<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>ProjectManagementSystem</display-name>

    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.servlet.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.servlet.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.servlet.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Add Project Servlet -->
    <servlet>
        <servlet-name>AddProjectServlet</servlet-name>
        <servlet-class>com.servlet.AddProjectServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddProjectServlet</servlet-name>
        <url-pattern>/addProject</url-pattern>
    </servlet-mapping>

    <!-- Update Project Servlet -->
    <servlet>
        <servlet-name>UpdateProjectServlet</servlet-name>
        <servlet-class>com.servlet.UpdateProjectServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateProjectServlet</servlet-name>
        <url-pattern>/updateProject</url-pattern>
    </servlet-mapping>

    <!-- Delete Project Servlet -->
    <servlet>
        <servlet-name>DeleteProjectServlet</servlet-name>
        <servlet-class>com.servlet.DeleteProjectServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteProjectServlet</servlet-name>
        <url-pattern>/deleteProject</url-pattern>
    </servlet-mapping>

    <!-- Update Status Servlet -->
    <servlet>
        <servlet-name>UpdateStatusServlet</servlet-name>
        <servlet-class>com.servlet.UpdateStatusServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateStatusServlet</servlet-name>
        <url-pattern>/updateStatus</url-pattern>
    </servlet-mapping>

    <!-- Edit Profile Servlet -->
    <servlet>
        <servlet-name>EditProfileServlet</servlet-name>
        <servlet-class>com.servlet.EditProfileServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditProfileServlet</servlet-name>
        <url-pattern>/editProfile</url-pattern>
    </servlet-mapping>

</web-app>